# Client-safe URLs only — VITE_ variables are bundled into the browser
# build, so nothing here should ever be a secret API key. Real AI provider
# keys live in Netlify's server-side environment variables (see below),
# never here.

# Existing rental qualification handoff — unchanged.
VITE_ARIA_HANDOFF_URL=https://example.com/.netlify/functions/agent-handoff

# Aria's request router. Leave unset for Netlify and Vercel deploys so the
# frontend uses the same-origin proxy at /api/aria-router.
# VITE_ARIA_ROUTER_URL=https://example.com/api/aria-router

# Specialist execution. All four can point at the SAME shared function —
# it reads `agentId` from the request body to know which specialist to run.
# Simplest option: set only VITE_SPECIALIST_AGENT_URL (realSpecialistProvider.js
# falls back to it for any specialist without its own URL) and skip the four
# lines below entirely.
VITE_SPECIALIST_AGENT_URL=https://example.com/.netlify/functions/specialist
# VITE_MARKETING_AGENT_URL=https://example.com/.netlify/functions/specialist
# VITE_CONVERSION_AGENT_URL=https://example.com/.netlify/functions/specialist
# VITE_WEBSITE_AGENT_URL=https://example.com/.netlify/functions/specialist
# VITE_LISTINGS_AGENT_URL=https://example.com/.netlify/functions/specialist

# Runs only after the owner approves a pending change (Forge proposals, etc).
VITE_APPROVAL_EXECUTION_URL=https://example.com/.netlify/functions/approval-executor

# ---------------------------------------------------------------------------
# Server-side only (set these in the Netlify site's Environment Variables UI,
# NOT in this file, and NEVER with a VITE_ prefix):
#
#   ANTHROPIC_API_KEY   - required (default AI provider)
#   ANTHROPIC_MODEL     - optional, defaults to "claude-sonnet-5"
#   AI_PROVIDER         - optional, "anthropic" (default) or "openai"
#   OPENAI_API_KEY      - required only if AI_PROVIDER=openai
#   OPENAI_MODEL        - optional, defaults to "gpt-4o-mini"
# ---------------------------------------------------------------------------
